    {
      "object": "block",
      "id": "3fbc995b-3347-8170-ab2d-f982c947f904",
      "parent": {
        "type": "page_id",
        "page_id": "3f9c995b-3347-8104-b3b9-d6a7adbba082"
      },
      "created_time": "2026-10-16T16:25:00.000Z",
      "last_edited_time": "2026-10-16T16:25:00.000Z",
      "created_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "last_edited_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Hook: Ethiopia inaugurated Africa’s largest hydropower dam, but tensions over Nile water rights are escalating.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Hook: Ethiopia inaugurated Africa’s largest hydropower dam, but tensions over Nile water rights are escalating.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      },
      "archived": false
    },
    {
      "object": "block",
      "id": "3fbc995b-3347-812a-8188-faf1bc4a5f98",
      "parent": {
        "type": "page_id",
        "page_id": "3f9c995b-3347-8104-b3b9-d6a7adbba082"
      },
      "created_time": "2026-10-16T16:25:00.000Z",
      "last_edited_time": "2026-10-16T16:25:00.000Z",
      "created_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "last_edited_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Define the Issue: The Grand Ethiopian Renaissance Dam (GERD) on the Blue Nile has a 5,150 MW capacity, marking a major hydropower milestone. Yet downstream Egypt rejects the dam’s legitimacy and demands a binding operational agreement, while Ethiopia insists on unilateral control and further tributary development.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Define the Issue: The Grand Ethiopian Renaissance Dam (GERD) on the Blue Nile has a 5,150 MW capacity, marking a major hydropower milestone. Yet downstream Egypt rejects the dam’s legitimacy and demands a binding operational agreement, while Ethiopia insists on unilateral control and further tributary development.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      },
      "archived": false
    },
    {
      "object": "block",
      "id": "3fbc995b-3347-8105-b7ed-d6381605d6fc",
      "parent": {
        "type": "page_id",
        "page_id": "3f9c995b-3347-8104-b3b9-d6a7adbba082"
      },
      "created_time": "2026-10-16T16:25:00.000Z",
      "last_edited_time": "2026-10-16T16:25:00.000Z",
      "created_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "last_edited_by": {
        "object": "user",
        "id": "38ac995b-3347-81e6-9e07-0027f67f6ed0"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Describe the Situation: Construction of GERD began in April 2011 and Ethiopia completed and inaugurated it in September 2025, fully funding the project without international aid. Egypt suspended negotiations in December 2023, citing the need for a legal agreement on dam filling and operation. Sudan, located downstream, reports damage to its own dams and water supply amid its internal conflict since April 2023. The US has offered mediation, though Ethiopia denies claims of US financing. Ethiopia also contests the 1959 Nile water agreement between Egypt and Sudan as a colonial relic and plans to develop more Nile tributaries independently if no significant harm is caused.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Describe the Situation: Construction of GERD began in April 2011 and Ethiopia completed and inaugurated it in September 2025, fully funding the project without international aid. Egypt suspended negotiations in December 2023, citing the need for a legal agreement on dam filling and operation. Sudan, located downstream, reports damage to its own dams and water supply amid its internal conflict since April 2023. The US has offered mediation, though Ethiopia denies claims of US financing. Ethiopia also contests the 1959 Nile water agreement between Egypt and Sudan as a colonial relic and plans to develop more Nile tributaries independently if no significant harm is caused.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      },
      "archived": false
    },
