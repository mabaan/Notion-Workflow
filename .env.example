# Notion
NOTION_TOKEN=
NOTION_SOURCE_REGISTRY_DATABASE_ID=
NOTION_ARTICLE_QUEUE_DATABASE_ID=
NOTION_DATASET_MEETINGS_DATABASE_ID=
NOTION_NEWSLETTERS_DATABASE_ID=
NOTION_SOCIAL_MEDIA_DATABASE_ID=

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Opt-in Luna selection; deterministic preserves the legacy selection path
ARTICLE_SELECTION_MODE=deterministic
# Four-source direct listing supplement; shadow only, requires --dry-run
DIRECT_SITE_DISCOVERY_ENABLED=false
# Resolve Google wrappers only immediately before bounded detailed enrichment
GOOGLE_NEWS_URL_RESOLUTION_ENABLED=false
# Luna detailed-enrichment attempts across RSS and discovery; hard maximum 48
ARTICLE_ENRICHMENT_INITIAL_BUDGET=32
ARTICLE_ENRICHMENT_MAX_BUDGET=48
ARTICLE_ENRICHMENT_BACKFILL_BATCH=8
# Legacy ARTICLE_ENRICHMENT_BUDGET remains an alias for the INITIAL budget.
# Set MAX_BUDGET equal to INITIAL_BUDGET for a fixed attempt ceiling.
CLASSIFICATION_MODEL=gpt-6-luna
CLASSIFICATION_BATCH_SIZE=100
CLASSIFICATION_MAX_REQUEST_BYTES=200000
CLASSIFICATION_MAX_OUTPUT_TOKENS=32768
CLASSIFICATION_MAX_ATTEMPTS=2
CLASSIFICATION_TIMEOUT_SECONDS=120

# Discovery providers
UNSPLASH_ACCESS_KEY=
BRAVE_SEARCH_API_KEY=
NEWS_API_KEY=
NEWS_DISCOVERY_PROVIDERS=brave,newsapi
IMAGE_DISCOVERY_PROVIDERS=unsplash,brave

# Weekly HITL coverage targets
ARTICLE_QUEUE_WEEKLY_TARGET_GLOBAL=3
ARTICLE_QUEUE_WEEKLY_TARGET_UAE=4
ARTICLE_QUEUE_WEEKLY_TARGET_KSA=3
ARTICLE_QUEUE_WEEKLY_TARGET_EGYPT=2

# Regional discovery settings
DISCOVERY_GLOBAL_COUNTRIES=ALL
DISCOVERY_UAE_COUNTRIES=AE
DISCOVERY_KSA_COUNTRIES=SA
DISCOVERY_EGYPT_COUNTRIES=EG
DISCOVERY_GLOBAL_LANGUAGES=en
DISCOVERY_UAE_LANGUAGES=en,ar
DISCOVERY_KSA_LANGUAGES=en,ar
DISCOVERY_EGYPT_LANGUAGES=en,ar
DISCOVERY_TOPICS=food security,water security,net zero transition,energy transition,trade,resilience,regulation,supply chains,desalination,agri-food
BRAVE_MAX_REQUESTS_PER_RUN=20
NEWSAPI_MAX_REQUESTS_PER_RUN=20

# Runtime
LOCAL_STATE_PATH=.local_state
LOG_LEVEL=INFO
MAX_ARTICLES_PER_RUN=12
MIN_ARTICLE_RELEVANCE_SCORE=4
MAX_ARTICLES_PER_PUBLISHER_PER_WEEK=2
ARTICLE_FRESHNESS_DAYS=7
ARTICLE_SHORTLIST_INITIAL_PER_REGION=6
ARTICLE_SHORTLIST_MAX_PER_REGION=8
