# Notion
NOTION_TOKEN=
NOTION_SOURCE_REGISTRY_DATABASE_ID=
NOTION_ARTICLE_QUEUE_DATABASE_ID=
NOTION_DATASET_MEETINGS_DATABASE_ID=
NOTION_NEWSLETTERS_DATABASE_ID=
NOTION_SOCIAL_MEDIA_DATABASE_ID=

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Discovery providers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
BRAVE_SEARCH_API_KEY=
NEWS_API_KEY=
SERPAPI_API_KEY=
NEWS_DISCOVERY_PROVIDERS=brave,newsapi
IMAGE_DISCOVERY_PROVIDERS=unsplash,brave

# Weekly HITL coverage targets
ARTICLE_QUEUE_WEEKLY_TARGET_GLOBAL=2
ARTICLE_QUEUE_WEEKLY_TARGET_UAE=2
ARTICLE_QUEUE_WEEKLY_TARGET_KSA=2
ARTICLE_QUEUE_WEEKLY_TARGET_EGYPT=2

# Regional discovery settings
DISCOVERY_GLOBAL_COUNTRIES=ALL
DISCOVERY_UAE_COUNTRIES=AE
DISCOVERY_KSA_COUNTRIES=SA
DISCOVERY_EGYPT_COUNTRIES=EG
DISCOVERY_GLOBAL_LANGUAGES=en
DISCOVERY_UAE_LANGUAGES=en,ar
DISCOVERY_KSA_LANGUAGES=en,ar
DISCOVERY_EGYPT_LANGUAGES=en,ar
DISCOVERY_TOPICS=food security,water security,net zero transition,energy transition,trade,resilience,regulation,supply chains,desalination,agri-food
BRAVE_MAX_REQUESTS_PER_RUN=20
NEWSAPI_MAX_REQUESTS_PER_RUN=20
SERPAPI_MAX_REQUESTS_PER_RUN=10

# Runtime
LOCAL_STATE_PATH=.local_state
LOG_LEVEL=INFO
MAX_ARTICLES_PER_RUN=10
MIN_ARTICLE_RELEVANCE_SCORE=4
MAX_ARTICLES_PER_SOURCE_PER_RUN=2
